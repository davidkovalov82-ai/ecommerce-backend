# База данни на Users
DB_HOST=localhost
DB_PORT=5432
DB_USER=users
DB_PASSWORD=users
DB_NAME=users

# Администраторски достъп за изпълнение на тестови бази в pytest (не се използва в прод)
DB_ADMIN_USER=commerce
DB_ADMIN_PASSWORD=commerce
DB_ADMIN_NAME=commerce

# Порт на услугата
APP_PORT=8002

# Асиметрични JWT ключове (RS256)
# За локална среда генерирайте с: python scripts/generate_keys.py
# Зарежда се директно от път към файл или през променливи на средата.
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_ISSUER=ecommerce-users
JWT_AUDIENCE=ecommerce
JWT_PRIVATE_KEY_PATH=jwt_private.pem
JWT_PUBLIC_KEY_PATH=jwt_public.pem

# Алтернативно: цялото съдържание на PEM ключа като низ
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# SMTP настройки за имейл известия (напр. Mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@example.com

# Настройки за възстановяване на парола
PASSWORD_RESET_EXPIRE_MINUTES=15
PASSWORD_RESET_BASE_URL=http://localhost:8002/auth/password-reset/confirm

