# PostgreSQL настройки за изолираната база и роля на notifications
DB_HOST=localhost
DB_PORT=5432
DB_USER=notifications
DB_PASSWORD=notifications
DB_NAME=notifications
DB_ADMIN_USER=commerce
DB_ADMIN_PASSWORD=commerce
DB_ADMIN_NAME=commerce

# RabbitMQ брокер
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=commerce.events
RABBITMQ_EVENTS_QUEUE=notifications.events
RABBITMQ_DLX_EXCHANGE=notifications.dlx
RABBITMQ_DLQ_QUEUE=notifications.events.dlq
RABBITMQ_DLQ_ROUTING_KEY=notifications.events.dead

# SMTP / Mailpit настройки
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@example.com
MAILPIT_WEB_URL=http://localhost:8025

# SMS провайдър (Twilio адаптер в безопасен тестов режим без реални плащания)
SMS_MODE=test
SMS_API_BASE_URL=
SMS_ACCOUNT_SID=AC00000000000000000000000000000000
SMS_AUTH_TOKEN=test-twilio-auth-token
SMS_FROM_NUMBER=+359888000000

# Параметри на каналите и worker процеса
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_DELAY_SECONDS=5
SMS_MAX_ATTEMPTS=3
SMS_RETRY_DELAY_SECONDS=2
DELIVERY_LEASE_SECONDS=60
WORKER_POLL_INTERVAL_SECONDS=0.5

