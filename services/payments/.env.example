DB_HOST=localhost
DB_PORT=5432
DB_USER=payments
DB_PASSWORD=payments
DB_NAME=payments

# Админ роля само за създаване на тестовата БД payments_test в pytest
DB_ADMIN_USER=commerce
DB_ADMIN_PASSWORD=commerce
DB_ADMIN_NAME=commerce

# Задължителна вътрешна тайна за защита на /internal/payments/* (минимум 16 байта)
PAYMENTS_INTERNAL_AUTH_TOKEN=

# Stripe настройки (собственост единствено на services/payments)
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:8000/orders/{order_id}?payment=success
STRIPE_CANCEL_URL=http://localhost:8000/orders/{order_id}?payment=cancelled
STRIPE_TIMEOUT_SECONDS=10.0

# RabbitMQ настройки за изпращане на платежни резултати към Commerce
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=payments.events
RABBITMQ_COMMERCE_QUEUE=commerce.payment_events
RABBITMQ_DLX_EXCHANGE=commerce.payments.dlx
RABBITMQ_DLQ_QUEUE=commerce.payment_events.dlq
RABBITMQ_DLQ_ROUTING_KEY=commerce.payment_events.dead

