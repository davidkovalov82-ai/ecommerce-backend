DB_HOST=localhost
DB_PORT=5432
DB_USER=commerce
DB_PASSWORD=commerce
DB_NAME=commerce
# Случайна тайна от поне 32 байта за подписване на JWT (няма работеща стойност по подразбиране)
JWT_SECRET=

# Stripe Sandbox конфигурация
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:8000/orders/{order_id}?payment=success
STRIPE_CANCEL_URL=http://localhost:8000/orders/{order_id}?payment=cancelled

# Mailpit / SMTP конфигурация за възстановяване на парола (accounts)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@example.com

# RabbitMQ конфигурация за изходящи събития (Transactional Outbox -> RabbitMQ)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
