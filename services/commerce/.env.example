DB_HOST=localhost
DB_PORT=5432
# За локална работа и миграции с администратор или отделна работна роля (напр. commerce_app в Compose)
DB_USER=commerce
DB_PASSWORD=commerce
DB_NAME=commerce
# По желание: отделна административна роля само за създаване на тестови БД в pytest
# DB_ADMIN_USER=commerce
# DB_ADMIN_PASSWORD=commerce
# DB_ADMIN_NAME=commerce
# Случайна тайна от поне 32 байта за подписване на JWT (няма работеща стойност по подразбиране)
JWT_SECRET=

# Независим Payments сервис (Commerce не съхранява Stripe ключове или webhook тайна)
PAYMENTS_BASE_URL=http://localhost:8001
PAYMENTS_INTERNAL_AUTH_TOKEN=
PAYMENTS_TIMEOUT_SECONDS=10.0

# Mailpit / SMTP конфигурация за възстановяване на парола (accounts)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@example.com

# RabbitMQ конфигурация за изходящи събития и входящи платежни резултати от Payments
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_PAYMENTS_EXCHANGE=payments.events
RABBITMQ_PAYMENTS_QUEUE=commerce.payment_events
RABBITMQ_PAYMENTS_DLX_EXCHANGE=commerce.payments.dlx
RABBITMQ_PAYMENTS_DLQ_QUEUE=commerce.payment_events.dlq
RABBITMQ_PAYMENTS_DLQ_ROUTING_KEY=commerce.payment_events.dead
